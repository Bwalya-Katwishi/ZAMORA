# Local development only. Do not deploy these values.
DATABASE_URL=postgres://zamora:zamora@localhost:5432/zamora
POSTGRES_USER=zamora
POSTGRES_PASSWORD=zamora
POSTGRES_DB=zamora
POSTGRES_PORT=5432

# At least 12 characters. The seed script refuses to run without this.
SEED_PASSWORD=

# A long random string used to hash session tokens.
SESSION_SECRET=

# Ask-the-shelf embeds locally (zamora-hash-v1). No embedding API key is used.
